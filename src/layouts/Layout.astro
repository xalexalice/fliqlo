---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import catalogue from '../data/clocks.json';
import languages from '../data/languages.json';
import { path, repo } from '../lib/paths';
interface Props { title?: string; description?: string; page?: string; clock?: { id: string; name: string } }
const { title = 'Still 时刻 — 让时间，慢一点。', description = '精选浏览器时钟。翻页、数字与指针，收藏喜欢的设计，下载独立 HTML，给专注留一点空间。', page = 'gallery', clock } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111714" /><title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/png" href={path('assets/logo.png')} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={new URL(path('assets/logo.png'), Astro.site)} />
  </head>
  <body data-page={page} data-detail-clock={clock?.id} data-detail-name={clock?.name}>
    <a href="#main" class="skip-link" data-i18n="skip">跳到主要内容</a>
    <header class="site-header"><div class="header-inner">
      <a href={path()} class="brand" aria-label="Still 时刻首页" data-i18n-aria-label="brand.home"><img src={path('assets/logo.png')} alt="SY" width="42" height="42" /><span>still<span class="brand-cn" data-i18n="brand.moment">时刻</span></span></a>
      <nav aria-label="主导航" data-i18n-aria-label="nav.label"><a href={path()} aria-current={page === 'gallery' ? 'page' : undefined} data-i18n="nav.gallery">时钟画廊</a><a href={path('favorites/')} aria-current={page === 'favorites' ? 'page' : undefined}><span data-i18n="nav.favorites">我的收藏</span><span class="favorite-count" data-favorite-count>0</span></a><a href={path('submit/')} aria-current={page === 'submit' ? 'page' : undefined} data-i18n="nav.submit">提交时钟</a></nav>
      <div class="header-actions"><select id="site-language" aria-label="语言" data-i18n-aria-label="language">{Object.entries(languages).map(([locale, copy]) => <option value={locale}>{copy.label}</option>)}</select><a class="github-link" href={repo} target="_blank" rel="noopener" aria-label="GitHub">GitHub<Icon name="external" size={15} /></a></div>
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div><a class="footer-brand" href={path()}>still<span data-i18n="footer.tagline">时间本身，就是风景。</span></a><p data-i18n="footer.description">在浏览器里，为专注留一点空间。</p></div><div class="footer-links"><a href={repo} target="_blank" rel="noopener"><span data-i18n="footer.source">开源代码</span><Icon name="external" size={14} /></a><a href={path('submit/')}><span data-i18n="footer.contribute">贡献一款时钟</span><Icon name="arrow" size={14} /></a><span>© {new Date().getFullYear()} Still · <span data-i18n="footer.moment">Made for the moment</span></span></div></footer>
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <dialog id="share-dialog"><form method="dialog"><button class="dialog-close" aria-label="关闭" data-i18n-aria-label="share.close">×</button></form><h2 data-i18n="share.dialogTitle">分享这个时刻</h2><p data-i18n="share.dialogDescription">复制链接，发送给朋友。</p><label for="share-url" class="sr-only" data-i18n="share.linkLabel">分享链接</label><input id="share-url" type="text" readonly /><button id="copy-link" class="button button-primary" data-i18n="share.copy">复制链接</button><p id="copy-status" role="status"></p></dialog>
    <script type="application/json" id="catalogue" set:html={JSON.stringify(catalogue)} />
    <script src="../scripts/gallery.ts"></script>
  </body>
</html>
