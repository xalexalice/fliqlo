---
import Layout from '../../layouts/Layout.astro';
import ClockPreview from '../../components/ClockPreview.astro';
import Icon from '../../components/Icon.astro';
import clocks from '../../data/clocks.json';
import { path, playPath } from '../../lib/paths';
export function getStaticPaths() { return clocks.map(clock => ({ params: { id: clock.id }, props: { clock } })); }
const { clock } = Astro.props;
---
<Layout title={`${clock.name} — Still 时刻`} description={clock.description} page="detail" clock={clock}>
  <section class="detail-page container"><a href={path()} class="back-link" data-i18n="detail.back">← 返回时钟画廊</a><div class="detail-grid"><div class="detail-preview"><ClockPreview style={clock.style} large /><span class="detail-preview-note" data-i18n="detail.preview">外观预览 · 点击右侧按钮运行</span></div><div class="detail-info"><p class="eyebrow"><span data-i18n={`category.${clock.category}`}>{clock.category}</span> / <span data-clock-subtitle={clock.id}>{clock.subtitle}</span></p><h1>{clock.name}</h1><div class="detail-tags">{clock.tags.map(tag => <span data-i18n={`tag.${tag}`}>{tag}</span>)}</div><p class="detail-description" data-i18n={`clock.description.${clock.id}`}>{clock.description}</p><a href={playPath(clock.id)} target="_blank" rel="noopener" class="button button-primary detail-launch"><span data-i18n="detail.open">打开时钟</span><Icon name="external" size={18} /></a><div class="detail-actions"><button class="button button-secondary" data-favorite={clock.id} aria-pressed="false" aria-label={`收藏 ${clock.name}`}><Icon name="heart" size={18} /><span data-favorite-label>收藏</span></button><button class="button button-secondary" data-share-clock={clock.id}><Icon name="share" size={18} /><span data-i18n="detail.share">分享</span></button><a href={playPath(clock.id)} download={`${clock.id}.html`} class="button button-secondary"><Icon name="download" size={18} />HTML</a></div><dl class="clock-facts"><div><dt data-i18n="detail.author">创作者</dt><dd>{clock.author}</dd></div><div><dt data-i18n="detail.license">使用许可</dt><dd data-i18n={clock.id === 'fliqlo' ? 'detail.originalLicense' : undefined}>{clock.license}</dd></div><div><dt data-i18n="detail.run">运行方式</dt><dd data-i18n={clock.offline ? 'detail.offline' : 'detail.online'}>{clock.offline ? '单文件 HTML · 支持离线' : '单文件 HTML · 需联网加载字体与样式'}</dd></div><div><dt data-i18n="detail.source">代码来源</dt><dd><a href={clock.source} target="_blank" rel="noopener"><span data-i18n="detail.viewSource">查看源代码</span><Icon name="external" size={14} /></a></dd></div></dl></div></div></section>
  <section class="detail-tip container"><p class="eyebrow" data-i18n="detail.eyebrow">A MOMENT TO YOURSELF</p><h2 data-i18n="detail.title" data-i18n-html>关掉多余的标签，<br />打开一点专注的空间。</h2><p data-i18n="detail.tip">时钟按设备本地时间运行。全屏模式与屏幕常亮可在打开后设置。</p></section>
</Layout>
