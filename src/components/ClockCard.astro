---
import ClockPreview from './ClockPreview.astro';
import Icon from './Icon.astro';
import { path, playPath } from '../lib/paths';
import catalogue from '../data/clocks.json';
interface Props { clock: typeof catalogue[number]; hidden?: boolean }
const { clock, hidden = false } = Astro.props;
---
<article class="clock-card" data-clock-id={clock.id} hidden={hidden}>
  <a class="card-preview-link" href={path(`clocks/${clock.id}/`)} aria-label={`查看 ${clock.name} 时钟`}><ClockPreview style={clock.style} /></a>
  <div class="card-body">
    <div class="card-heading"><div><a href={path(`clocks/${clock.id}/`)} class="card-title">{clock.name}</a><p>{clock.subtitle}</p></div><button class="icon-button favorite-button" data-favorite={clock.id} aria-label={`收藏 ${clock.name}`} aria-pressed="false"><Icon name="heart" /></button></div>
    <div class="card-bottom"><span class="card-tag">{clock.category}</span><span class="card-meta">{clock.offline ? '离线可用' : '原版保留'}</span><a class="card-launch" href={playPath(clock.id)} target="_blank" rel="noopener" aria-label={`打开 ${clock.name} 时钟`}>打开<Icon name="external" size={14} /></a></div>
  </div>
</article>
